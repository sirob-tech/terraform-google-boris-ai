# Terraform working directories and state. Nothing generated by a local plan or
# apply belongs in a public module repo.
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
crash.log
crash.*.log

# Variable files, which routinely carry org IDs, billing accounts, and customer
# IDs. The module takes all of its inputs explicitly, so none are needed here.
*.tfvars
*.tfvars.json

# Plan output, including the extensionless forms `plan -out=tfplan` produces.
# A saved plan records input variable values in the clear — sensitive = true
# suppresses display, not storage — so these are secret-bearing artifacts.
*.tfplan
tfplan
tfplan.*
plan.out

# Local credential material. Nothing in this module needs a service-account key,
# and a stray one here would contradict the whole premise of the module.
.env
.env.*
credentials.json
*-sa-key.json
service-account*.json

# Terraform override files, a common home for local experiments.
override.tf
override.tf.json
*_override.tf
*_override.tf.json

.DS_Store
